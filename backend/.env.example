# Copy to .env and fill in a real Postgres connection string, e.g. from
# Neon, Supabase, Railway, RDS, or a local Postgres install / Docker container.
DATABASE_URL="postgresql://user:password@localhost:5432/homiai?schema=public"

PORT=3000

# Used server-side only for AI natural-language search parsing (CLAUDE.md §1 —
# the mobile client never calls Claude directly). Get one at
# console.anthropic.com -> API Keys -> Create Key.
ANTHROPIC_API_KEY="sk-ant-..."

# Signs Phone OTP login sessions (backend/src/auth/). Generate a random
# secret, e.g. `openssl rand -hex 48`.
JWT_SECRET=""

# No SMS provider configured — OTP codes are logged to the backend console
# instead of texted (backend/src/auth/console-sms.provider.ts). Set these
# three to switch to real Twilio delivery:
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# No image-gen provider configured — AI Home Designer returns a placeholder
# photo (backend/src/designs/placeholder-image-gen.provider.ts). Set this to
# switch to real redesigns via Replicate's adirik/interior-design model:
# REPLICATE_API_TOKEN=""

# No S3 bucket configured — uploaded photos are stored on local disk
# (backend/uploads/, served at /uploads/*) instead of S3. Set these to
# switch to real S3 (or an S3-compatible endpoint via AWS_S3_ENDPOINT, e.g.
# Cloudflare R2 / MinIO):
# AWS_S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_S3_ENDPOINT=""
# AWS_S3_PUBLIC_URL=""

# Shared secret checked against the Authorization header on incoming
# RevenueCat webhooks (POST /webhooks/revenuecat) — set the same value in
# the RevenueCat dashboard's webhook "Authorization header value" field.
# REVENUECAT_WEBHOOK_SECRET=""
