# Copy to .env and fill in real values. All EXPO_PUBLIC_* vars get bundled
# into the client JS — never put a secret (server-only) key in here, only
# public/client-safe tokens.

# Only needed for device testing / when the backend isn't on the same
# machine as the app (see mobile/src/api/client.ts).
# EXPO_PUBLIC_API_URL="http://192.168.1.20:3000"

# Public token (starts with pk., never sk.) from
# https://account.mapbox.com/access-tokens/ — enables the price-marker map
# in SearchResultsScreen. Without it, the map tab shows a plain-language
# "not configured" message instead.
# EXPO_PUBLIC_MAPBOX_TOKEN="pk...."

# Android public SDK key from the RevenueCat dashboard — enables real
# Google Play Billing purchases in PricingScreen. Without it, choosing a
# plan just sets the tier directly (no payment). Requires a custom dev
# client / EAS Build to actually process a purchase — doesn't work in
# Expo Go or plain `expo start`.
# EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY="goog_...."
